<Window x:Class="XPhone.UI.PairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:XPhone.UI"
        Title="Сопряжение по Wi-Fi" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource Window}" Background="{StaticResource Dialog}" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel>
        <StackPanel Margin="22,20,22,6">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Sel}" Margin="0,0,12,0">
                    <ui:Icon Kind="wifi" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Сопряжение по Wi-Fi" Style="{StaticResource H2}" />
                    <TextBlock Text="Нужно один раз. Дальше телефон будет находиться сам." Style="{StaticResource Note}" />
                </StackPanel>
            </StackPanel>

            <!-- Предупреждение: мешает VPN -->
            <Border x:Name="VpnBox" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Muted}"
                    Background="{StaticResource Card}" Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Icon Kind="triangle-alert" Size="18" Margin="0,0,10,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Мешает VPN" FontWeight="Bold" FontSize="13" />
                        <TextBlock x:Name="VpnText" Style="{StaticResource Note}" Foreground="#B4B7C0" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Выбор способа -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton x:Name="ModeQr" Style="{StaticResource Seg}" GroupName="mode" IsChecked="True" Checked="Mode_Changed"
                             AutomationProperties.Name="QR-код">
                    <StackPanel Orientation="Horizontal">
                        <ui:Icon Kind="scan" Size="14" Margin="0,0,6,0" />
                        <TextBlock Text="QR-код" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ModeCode" Style="{StaticResource Seg}" GroupName="mode" Checked="Mode_Changed"
                             AutomationProperties.Name="Код из 6 цифр">
                    <StackPanel Orientation="Horizontal">
                        <ui:Icon Kind="link" Size="14" Margin="0,0,6,0" />
                        <TextBlock Text="Код из 6 цифр" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- ── QR-код ── -->
            <Grid x:Name="QrPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- QR рисуем тёмным на белом: так его надёжно читает камера. -->
                <Border Width="216" Height="216" CornerRadius="12" Background="White" Padding="10">
                    <Image x:Name="QrImage" RenderOptions.EdgeMode="Aliased" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Note}" Foreground="#B4B7C0" Margin="0,0,0,8">
                        <Run FontWeight="Bold" Foreground="{StaticResource Text}">1.</Run> Телефон и компьютер — в одной сети.
                    </TextBlock>
                    <TextBlock Style="{StaticResource Note}" Foreground="#B4B7C0" Margin="0,0,0,8">
                        <Run FontWeight="Bold" Foreground="{StaticResource Text}">2.</Run> На телефоне: Настройки → Параметры разработчика → <Run FontWeight="SemiBold" Foreground="{StaticResource Text}">Отладка по Wi-Fi</Run>.
                    </TextBlock>
                    <TextBlock Style="{StaticResource Note}" Foreground="#B4B7C0" Margin="0,0,0,14">
                        <Run FontWeight="Bold" Foreground="{StaticResource Text}">3.</Run> Нажмите <Run FontWeight="SemiBold" Foreground="{StaticResource Text}">«Подключить устройство с помощью QR-кода»</Run> и наведите камеру на этот код.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <ui:Icon Kind="loader" Size="16" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <ui:Icon.RenderTransform>
                                <RotateTransform x:Name="SpinAngle" />
                            </ui:Icon.RenderTransform>
                        </ui:Icon>
                        <TextBlock x:Name="QrWait" Text="Ждём телефон…" FontSize="12" Foreground="{StaticResource Silver}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ── Код из 6 цифр ── -->
            <StackPanel x:Name="CodePanel" Visibility="Collapsed">
                <Border Style="{StaticResource CardBox}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Note}" Foreground="#B4B7C0" Margin="0,0,0,6">
                            <Run FontWeight="Bold" Foreground="{StaticResource Text}">1.</Run> На телефоне: Настройки → Параметры разработчика → <Run FontWeight="SemiBold" Foreground="{StaticResource Text}">Отладка по Wi-Fi</Run> → включить.
                        </TextBlock>
                        <TextBlock Style="{StaticResource Note}" Foreground="#B4B7C0">
                            <Run FontWeight="Bold" Foreground="{StaticResource Text}">2.</Run> Нажмите <Run FontWeight="SemiBold" Foreground="{StaticResource Text}">«Подключить устройство с помощью кода»</Run> и введите сюда адрес и код из появившегося окна.
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="IP-адрес и порт" Style="{StaticResource Label}" />
                        <TextBox x:Name="AddressBox" Style="{StaticResource Input}" TextChanged="AddressBox_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Код (6 цифр)" Style="{StaticResource Label}" />
                        <TextBox x:Name="CodeBox" Style="{StaticResource Input}" MaxLength="6" FontSize="16" FontWeight="SemiBold"
                                 PreviewTextInput="CodeBox_PreviewTextInput" KeyDown="CodeBox_KeyDown" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0" Text="Например: 192.168.1.23:37145" />
                <StackPanel x:Name="FoundPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                    <ui:Icon Kind="search" Size="15" Foreground="{StaticResource Silver}" Margin="0,0,8,0" />
                    <TextBlock x:Name="FoundText" FontSize="12" Foreground="{StaticResource Silver}" />
                </StackPanel>
            </StackPanel>

            <!-- Состояние / ошибка -->
            <Border x:Name="StatusBox" Margin="0,14,0,0" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Line2}"
                    Background="{StaticResource Card}" Padding="12,10" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Icon x:Name="StatusIcon" Kind="info" Size="18" Margin="0,0,10,0" VerticalAlignment="Top" />
                    <TextBlock x:Name="StatusText" Grid.Column="1" TextWrapping="Wrap" FontSize="13" />
                </Grid>
            </Border>
        </StackPanel>

        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,14" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource Btn}" Content="Отмена" Click="Cancel_Click" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="PairButton" Style="{StaticResource BtnPrimary}" Click="Pair_Click" AutomationProperties.Name="Сопрячь" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <ui:Icon Kind="link" Size="16" StrokeThickness="2" Margin="0,0,8,0" />
                        <TextBlock Text="Сопрячь" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
