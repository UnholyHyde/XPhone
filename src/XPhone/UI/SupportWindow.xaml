<Window x:Class="XPhone.UI.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поддержка и связь" Width="480" SizeToContent="Height" MaxHeight="680"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource Window}" Background="{StaticResource Dialog}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Поддержать разработку XPhone" Style="{StaticResource H2}" TextWrapping="Wrap" />
            <TextBlock Text="Если XPhone оказался полезен, можно угостить разработчика кофе. Поддержка добровольная и не влияет на доступность функций."
                       Style="{StaticResource Note}" Margin="0,12,0,18" />
            <Button x:Name="DonateButton" Content="Поддержать через DonatePay" Style="{StaticResource BtnPrimary}" Click="Donate_Click" />
            <TextBlock Text="Откроется страница автора в браузере. Оплата проходит на стороне DonatePay."
                       Style="{StaticResource Note}" Margin="0,8,0,24" />
            <TextBlock Text="Обратная связь" Style="{StaticResource H2}" Margin="0,0,0,12" />
            <Button Content="Telegram — новости и сообщество" Style="{StaticResource Btn}" Click="Telegram_Click" Margin="0,0,0,8" />
            <Button Content="GitHub Issues — ошибки и предложения" Style="{StaticResource Btn}" Click="Issues_Click" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource Silver}" Margin="0,12,0,0" />
            <Button Content="Закрыть" Style="{StaticResource Btn}" HorizontalAlignment="Right" Margin="0,18,0,0" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
